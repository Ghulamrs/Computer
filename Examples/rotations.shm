// rotations.shm
// The three axis rotations, each an
// array literal put in a local.
// Compare rotmat.shm, which fills a
// caller's array instead - use that
// when the result must outlive the
// call. This one reads closer to
// the matrix as written on paper.
//
// pi/4, not a right angle, on
// purpose: at pi/2 every entry is 0
// or 1 whether the trig ran or not.
// At pi/4 the off-diagonals are
// sqrt(2)/2 and the work shows.
fun <> = ROX(angle: real) {
  X : {{1.0,         0.,          0.},
       {0.,  cos(angle),  sin(angle)},
       {0., -sin(angle),  cos(angle)}}
  ? X
}

fun <> = ROY(angle: real) {
  Y : {{cos(angle), 0., -sin(angle)},
       {0.,        1.0,          0.},
       {sin(angle), 0.,  cos(angle)}}
  ? Y
}

fun <> = ROZ(angle: real) {
  Z : {{ cos(angle), sin(angle), 0.},
       {-sin(angle), cos(angle), 0.},
       {0.,                  0., 1.0}}
  ? Z
}

fun <> = main() {
  ? "Rx 45"
  ROX(pi/4.)
  ? "Ry 45"
  ROY(pi/4.)
  ? "Rz 45"
  ROZ(pi/4.)
}
// expected: Rx 45
// expected:  1.000000   0.000000   0.000000
// expected:  0.000000   0.707107   0.707107
// expected:  0.000000  -0.707107   0.707107
// expected: Ry 45
// expected:  0.707107   0.000000  -0.707107
// expected:  0.000000   1.000000   0.000000
// expected:  0.707107   0.000000   0.707107
// expected: Rz 45
// expected:  0.707107   0.707107   0.000000
// expected: -0.707107   0.707107   0.000000
// expected:  0.000000   0.000000   1.000000

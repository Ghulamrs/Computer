// rotations.shm
// The three axis rotations, each written as one array literal assigned straight
// into a local. Compare rotmat.shm, which fills a caller-supplied array instead:
// that shape is the one to reach for when the result has to outlive the call or
// be composed, but this one reads closer to how the matrix is written on paper.
//
// The angle is pi/4 rather than a right angle on purpose. At pi/2 every entry is
// exactly 0 or 1, which looks the same whether the trig was evaluated or not; at
// pi/4 the off-diagonal entries are sqrt(2)/2 and the arithmetic is visible.
fun <> = ROX(angle: real) {
  X : {{1.0,         0.,          0.},
       {0.,  cos(angle),  sin(angle)},
       {0., -sin(angle),  cos(angle)}}
  ? X
}

fun <> = ROY(angle: real) {
  Y : {{cos(angle), 0., -sin(angle)},
       {0.,        1.0,          0.},
       {sin(angle), 0.,  cos(angle)}}
  ? Y
}

fun <> = ROZ(angle: real) {
  Z : {{ cos(angle), sin(angle), 0.},
       {-sin(angle), cos(angle), 0.},
       {0.,                  0., 1.0}}
  ? Z
}

fun <> = main() {
  ? "Rx 45"
  ROX(pi/4.)
  ? "Ry 45"
  ROY(pi/4.)
  ? "Rz 45"
  ROZ(pi/4.)
}
// expected: Rx 45
// expected:  1.000000   0.000000   0.000000
// expected:  0.000000   0.707107   0.707107
// expected:  0.000000  -0.707107   0.707107
// expected: Ry 45
// expected:  0.707107   0.000000  -0.707107
// expected:  0.000000   1.000000   0.000000
// expected:  0.707107   0.000000   0.707107
// expected: Rz 45
// expected:  0.707107   0.707107   0.000000
// expected: -0.707107   0.707107   0.000000
// expected:  0.000000   0.000000   1.000000

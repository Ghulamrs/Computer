// rotmat.shm
// The three axis rotations and the
// composite RotMat = Rz Ry Rx, the
// yaw-pitch-roll order: roll first,
// yaw last. Each builder fills a
// caller's 3x3 instead of returning
// one, because an array argument is
// a reference - the same shape as
// invert.shm.
//
// These turn the axes, not the
// point: R v gives v read off the
// turned frame. So a yaw of 90 sends
// a point on x to -y, which is the
// same thing as the frame's y having
// swung round to where x was.
// Right-handed, and the sign says so:
// the -sin sits in the row directly
// above the row carrying the 1.0,
// counting round, so ROX puts it in
// the last row and ROZ in the middle
// one. rotations.shm writes the same
// three matrices as literals - the
// only difference here is where the
// answer is put.
fun <> = ROX(angle: real, R[][]: real) {
  real c : cos(angle)
  real s : sin(angle)
  R[0][0] : 1.0  R[0][1] : 0.0  R[0][2] : 0.0
  R[1][0] : 0.0  R[1][1] : c    R[1][2] : s
  R[2][0] : 0.0  R[2][1] : -s   R[2][2] : c
}

fun <> = ROY(angle: real, R[][]: real) {
  real c : cos(angle)
  real s : sin(angle)
  R[0][0] : c    R[0][1] : 0.0  R[0][2] : -s
  R[1][0] : 0.0  R[1][1] : 1.0  R[1][2] : 0.0
  R[2][0] : s    R[2][1] : 0.0  R[2][2] : c
}

fun <> = ROZ(angle: real, R[][]: real) {
  real c : cos(angle)
  real s : sin(angle)
  R[0][0] : c    R[0][1] : s    R[0][2] : 0.0
  R[1][0] : -s   R[1][1] : c    R[1][2] : 0.0
  R[2][0] : 0.0  R[2][1] : 0.0  R[2][2] : 1.0
}

// c : a b, sized from the operands,
// so this is not tied to 3x3. The
// accumulator is hoisted out of the
// loops: writing c[i][j] only once
// the sum is complete is what would
// let c alias a or b.
fun <> = matmul(a[][]: real,
                b[][]: real,
                c[][]: real) {
  int n : a.row
  int m : b.col
  int k : b.row
  real sum : 0.0

  for i < n {
    for j < m {
      sum : 0.0
      for p < k {
        sum +: a[i][p] * b[p][j]
      }
      c[i][j] : sum
    }
  }
}

// Degrees in, radians out. This
// once reached atan2(1,1) for pi/4,
// because the language had no
// constants. pi is built in now.
fun <real> = rad(deg: real) {
  return deg * pi / 180.0
}

fun <> = RotMat(roll: real,
                pitch: real,
                yaw: real,
                R[][]: real) {
  real X[3][3]
  real Y[3][3]
  real Z[3][3]
  real T[3][3]

  ROX(roll, X)
  ROY(pitch, Y)
  ROZ(yaw, Z)

  // Right to left: T holds Rz Ry,
  // then R holds T Rx, so R v turns
  // v by roll, pitch, then yaw.
  matmul(Z, Y, T)
  matmul(T, X, R)
}

fun <> = main() {
  real R[3][3]

  // Yaw 90: the frame's y swings to
  // where x was, so a point on x now
  // reads at -y.
  RotMat(rad(0.0), rad(0.0), rad(90.0), R)
  ? "yaw 90"
  ? R

  // Roll 90, to show the composite
  // is not silently transposed.
  RotMat(rad(90.0), rad(0.0), rad(0.0), R)
  ? "roll 90"
  ? R

  // All three at 90: Rz Ry Rx, not
  // the same as one axis alone.
  RotMat(rad(90.0), rad(90.0), rad(90.0), R)
  ? "roll pitch yaw 90"
  ? R
}
// expected: yaw 90
// expected:  0.000000   1.000000   0.000000
// expected: -1.000000   0.000000   0.000000
// expected:  0.000000   0.000000   1.000000
// expected: roll 90
// expected:  1.000000   0.000000   0.000000
// expected:  0.000000   0.000000   1.000000
// expected:  0.000000  -1.000000   0.000000
// expected: roll pitch yaw 90
// expected:  0.000000   0.000000   1.000000
// expected: -0.000000  -1.000000   0.000000
// expected:  1.000000  -0.000000   0.000000

// factorial.shm
// The same number two ways. The loop
// carries a running product forward;
// the function calls itself and lets
// the products pile up until the
// bottom is reached.
//
// A function that calls itself needs
// a case that does not, or it never
// comes back. Here it is n < 2, and
// every call moves towards it.
fun <int> = fact(n: int) {
  if n < 2 {
    return 1
  }
  return n * fact(n - 1)
}

fun <> = main() {
  n : 10
  f : 1
  for i : 2 to n {
    f : f * i
  }
  ? "factorial of" n
  ? "by loop" f
  ? "by recursion" fact(n)
}
// expected: factorial of 10
// expected: by loop 3628800
// expected: by recursion 3628800

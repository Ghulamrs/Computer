// invert.shm
// Gauss-Jordan elimination without pivoting, in place: the matrix is
// overwritten by its inverse and the determinant comes back as the value.
// Columns past the last row are carried as right-hand sides, so a matrix
// augmented with b comes back holding the inverse and A^-1 b together.
fun <real> = invert(a[][]: real) {
  real tol : pow(10.0, 0.0 - 30.0)
  real det : 1.0
  real r : 0.0
  int n : len(a)
  int nc : len(a[0])

  for i : 0 to n - 1 {
    det : det * a[i][i]

    // No pivoting, so a pivot that has collapsed is nursed rather than swapped
    // away: an exact zero means singular, anything smaller than tol is pinned
    // to tol so the division below stays finite.
    if abs(det) < tol | abs(det) = tol {
      if a[i][i] = 0.0 { return det }
      det : tol
    }

    // Writing 1 and 0 into the pivot column before scaling puts the identity
    // into the storage just read, which is what keeps the inverse in place.
    r : 1.0 / a[i][i]
    a[i][i] : 1.0
    for j : 0 to nc - 1 {
      a[i][j] : r * a[i][j]
    }

    for k : 0 to n - 1 {
      if k != i & a[k][i] != 0.0 {
        r : a[k][i]
        a[k][i] : 0.0
        for j : 0 to nc - 1 {
          a[k][j] -: r * a[i][j]
        }
      }
    }
  }

  return det
}

fun <> = main() {
  real m[3][3] : {{4.0, 7.0, 2.0},
                  {3.0, 6.0, 1.0},
                  {2.0, 5.0, 3.0}}
  real s[3][3] : {{1.0, 2.0, 3.0},
                  {2.0, 4.0, 6.0},
                  {1.0, 1.0, 1.0}}
  real ab[2][3] : {{2.0, 1.0, 1.0},
                   {1.0, 3.0, 2.0}}
  real d : 0.0

  d : invert(m)
  ? "inverse, det" d
  ? m

  // Second row is twice the first, so the second pivot arrives as an exact
  // zero and the run stops there.
  d : invert(s)
  ? "singular, det" d

  // Two equations in two unknowns with b in the third column: the 2x2 block
  // comes back as the inverse, the last column as the solution.
  d : invert(ab)
  ? "solved, det" d
  ? ab
}
// expected: inverse, det 9.0
// expected:  1.4444444  -1.2222222  -0.5555556
// expected: -0.7777778   0.8888889   0.2222222
// expected:  0.3333333  -0.6666667   0.3333333
// expected: singular, det 0.0
// expected: solved, det 5.0
// expected:  0.6000000  -0.2000000   0.2000000
// expected: -0.2000000   0.4000000   0.6000000
